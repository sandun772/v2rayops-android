<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Elevated Dark Squircle with Cyber Border -->
    <item
        android:width="84dp"
        android:height="84dp"
        android:gravity="center">
        <shape android:shape="rectangle">
            <corners android:radius="22dp" />
            <solid android:color="#0C101B" />
            <stroke
                android:width="1.5dp"
                android:color="#6366F1" />
        </shape>
    </item>

    <!-- Centered Trimmed V2 Logo -->
    <item
        android:width="58dp"
        android:height="42dp"
        android:gravity="center"
        android:drawable="@drawable/v2rayops_logo_trimmed" />
</layer-list>
